      <aliases enabled='yes' />
      <column caption='Total Sets Played' datatype='integer' name='[Calculation_1229868893491200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Champion_Sets] + [Runner_up_Sets]' />
      </column>
      <column caption='Match Type (M)' datatype='string' name='[Calculation_1229868893806593]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Runner_up_Sets] = 0 THEN &quot;Straight-Set Win&quot;&#13;&#10;ELSEIF [Calculation_1229868893491200] &gt;= 5 THEN &quot;Five-Set Battle&quot;&#13;&#10;ELSE &quot;Competitive Match&quot;&#13;&#10;END' />
      </column>
      <column caption='Dominance Score' datatype='real' name='[Calculation_1229868894064642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Game_Margin] / [Calculation_1229868893491200]' />
      </column>
      <column caption='Champion Seed Tier' datatype='string' name='[Calculation_1229868894162947]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Champion Seed]) THEN &quot;Unseeded / Unknown&quot;&#13;&#10;ELSEIF [Champion Seed] &lt;= 4 THEN &quot;Top 4 Seed&quot;&#13;&#10;ELSEIF [Champion Seed] &lt;= 16 THEN &quot;Seed 5-16&quot;&#13;&#10;ELSE &quot;Seed 17+&quot;&#13;&#10;END' />
      </column>
      <column caption='Upset Type' datatype='string' name='[Calculation_1229868895031300]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT [Champion_seeded] AND [Runner_up_seeded] THEN &quot;Unseeded Champion vs Seeded Runner-up&quot;&#13;&#10;ELSEIF [Champion_seeded] AND NOT [Runner_up_seeded] THEN &quot;Seeded Champion vs Unseeded Runner-up&quot;&#13;&#10;ELSEIF [Champion_seeded] AND [Runner_up_seeded] THEN &quot;Both Seeded&quot;&#13;&#10;ELSE &quot;Both Unseeded / Unknown&quot;&#13;&#10;END' />
        <aliases>
          <alias key='&quot;Both Unseeded / Unknown&quot;' value='Both Unseeded' />
        </aliases>
      </column>
      <column caption='Seed Gap' datatype='integer' name='[Calculation_1229868895309829]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Runner-up Seed] - [Champion Seed]' />
      </column>
      <column caption='Duration per Set' datatype='real' name='[Calculation_1229868895518726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1229868893491200] &gt; 0 THEN&#13;&#10;    [Mins_imputed] / [Calculation_1229868893491200]&#13;&#10;END' />
      </column>
      <column caption='Duration Category' datatype='string' name='[Calculation_1229868895682567]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Mins_imputed] &lt; 120 THEN &quot;Under 2 Hours&quot;&#13;&#10;ELSEIF [Mins_imputed] &lt; 180 THEN &quot;2-3 Hours&quot;&#13;&#10;ELSEIF [Mins_imputed] &lt; 240 THEN &quot;3-4 Hours&quot;&#13;&#10;ELSE &quot;4+ Hours&quot;&#13;&#10;END' />
      </column>
      <column caption='Seeded Champion' datatype='real' default-format='p0.00%' name='[Calculation_1229868901294091]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(INT([Champion_seeded])) / COUNT([Champion_seeded])' />
      </column>
      <column caption='Straight-Set Finals' datatype='real' default-format='p0.00%' name='[Calculation_1229868901949452]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(INT([Runner_up_Sets] = 0)) / COUNT([Runner_up_Sets])' />
      </column>
      <column caption='Decade' datatype='integer' name='[Calculation_1229868997775373]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT([Year] / 10) * 10' />
      </column>
      <column datatype='integer' name='[Champion Seed]' role='measure' type='quantitative' />
      <column datatype='string' name='[Champion]' role='dimension' type='nominal' />
      <column caption='Champion Sets' datatype='integer' name='[Champion_Sets]' role='measure' type='quantitative' />
      <column caption='Champion seeded' datatype='boolean' name='[Champion_seeded]' role='dimension' type='nominal' />
      <column datatype='date' name='[Decade (date)]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MAKEDATE( [Calculation_1229868997775373], 1, 1 )' />
      </column>
      <column caption='Game Margin' datatype='integer' name='[Game_Margin]' role='measure' type='quantitative' />
